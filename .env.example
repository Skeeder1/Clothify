# Clothify - Environment Variables

# ===========================================
# Google AI (required for image generation)
# ===========================================
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-api-key-here

# ===========================================
# Discord Bot Configuration
# ===========================================
# Get your token from Discord Developer Portal
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothify

# Individual PostgreSQL settings (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothify

# ===========================================
# File Paths (optional - defaults shown)
# ===========================================
INPUT_IMAGES_PATH=./images/input
OUTPUT_IMAGES_PATH=./images/output

# ===========================================
# Bot Settings (optional - defaults shown)
# ===========================================
# How often to check for completed jobs (seconds)
POLL_INTERVAL_SECONDS=5

# ===========================================
# n8n Configuration
# ===========================================
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-here
DISCORD_TOKEN=your-discord-token-here
