# ===========================================
# Clothify - Variables d'environnement
# ===========================================
# Configuration pour DEVELOPPEMENT LOCAL
# Pour Coolify, voir .env.coolify.example

# ===========================================
# Google AI (requis pour la generation d'images)
# ===========================================
# Obtenir une cle: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-api-key-here

# ===========================================
# Discord Bot
# ===========================================
# Token depuis Discord Developer Portal
DISCORD_TOKEN=your-discord-bot-token-here

# ===========================================
# Base de donnees PostgreSQL
# ===========================================
# Connection string complete
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothify

# Variables individuelles (pour docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothify

# ===========================================
# Chemins des fichiers images
# ===========================================
# Chemins RELATIFS pour dev local
INPUT_IMAGES_PATH=./images/input
OUTPUT_IMAGES_PATH=./images/output

# ===========================================
# n8n Configuration
# ===========================================
# Cle de chiffrement (generer: openssl rand -base64 32)
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-here

# ===========================================
# Options avancees (optionnel)
# ===========================================
# Intervalle de polling pour les jobs termines (secondes)
POLL_INTERVAL_SECONDS=5
