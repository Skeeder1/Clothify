# ===========================================
# Clothify - Template de Variables d'Environnement
# ===========================================
# Dernière mise à jour : 06/01/2026
# 
# Instructions :
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir les valeurs selon votre environnement (LOCAL ou PRODUCTION)
# 3. Ne JAMAIS commiter le fichier .env (contient des secrets)

# ===========================================
# DISCORD
# ===========================================
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_CHANNEL_NAME=bot_clothify
DISCORD_GUILD_ID=your-guild-id

# ===========================================
# DATABASE
# ===========================================
# LOCAL: postgresql://postgres:postgres@localhost:5432/clothify
# PRODUCTION: postgresql://postgres:postgres@postgres:5432/clothify
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothify

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothify

# ===========================================
# FILE PATHS
# ===========================================
# Volume Docker partagé entre bot et n8n : clothify_shared
# Structure automatique :
#   /clothify_shared/input_image/  (uploads Discord)
#   /clothify_shared/output_image/ (résultats IA)
#
# Le bot dérive automatiquement :
#   INPUT_DIR  = /clothify_shared/input_image
#   OUTPUT_DIR = /clothify_shared/output_image

SHARED_VOLUME_PATH=/clothify_shared

# ===========================================
# N8N
# ===========================================
N8N_PORT=5678
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ===========================================
# GOOGLE AI API
# ===========================================
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
