# ===========================================
# Clothify - .gitignore
# ===========================================

# Secrets & Environment
.env
.env.*
!.env.example
!.env.coolify.example

# Data & Volumes
n8n-data/
postgres-data/
local-files/*
!local-files/.gitkeep
images/input/*
images/output/*
!images/input/.gitkeep
!images/output/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
ENV/
env/
*.egg-info/
dist/
build/

# IDE & Editors
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Logs & Temporary
*.log
*.tmp
*.bak
*.cache
bot/tempo/

# Database
Database/.env
*.sql.gz
*.dump

# Archives & Backups
docs/archives/

# Keep SQL scripts
!Database/scripts/**/*.sql
