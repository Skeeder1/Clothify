# ===========================================
# Clothify - Variables d'environnement Coolify
# ===========================================
# Template pour le deploiement sur Coolify
# Copier les variables appropriees dans chaque service Coolify

# ===========================================
# SERVICE: Discord Bot (Git Repository)
# ===========================================
DISCORD_TOKEN=<votre-token-discord>
DATABASE_URL=postgresql://clothify_user:<password>@<postgres-internal-hostname>:5432/clothify

# Chemins dans le container (volumes Docker montes)
INPUT_IMAGES_PATH=/files/input
OUTPUT_IMAGES_PATH=/files/output

# ===========================================
# SERVICE: n8n (Docker Image)
# ===========================================
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris

# Generer avec: openssl rand -base64 32
N8N_ENCRYPTION_KEY=<generer-une-cle-unique>

# Google AI pour la generation d'images
GOOGLE_AI_API_KEY=<votre-cle-api-google>

# Connection PostgreSQL interne Coolify
DB_POSTGRESDB_HOST=<postgres-internal-hostname>
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=clothify
DB_POSTGRESDB_USER=clothify_user
DB_POSTGRESDB_PASSWORD=<password>

# Discord token pour n8n (si besoin d'envoyer des messages)
DISCORD_TOKEN=<votre-token-discord>

# ===========================================
# SERVICE: PostgreSQL (Database)
# ===========================================
# Configure directement dans Coolify lors de la creation du service:
# - Database Name: clothify
# - Username: clothify_user
# - Password: <generer un mot de passe fort>

# ===========================================
# NOTES IMPORTANTES
# ===========================================
# 1. Remplacer <postgres-internal-hostname> par le hostname interne
#    fourni par Coolify (ex: postgresql-abc123)
#
# 2. Les volumes partages doivent etre configures dans Coolify:
#    - clothify-images-input  -> /files/input
#    - clothify-images-output -> /files/output
#
# 3. S'assurer que tous les services sont dans le meme network Coolify
