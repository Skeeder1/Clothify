    {
      "parameters": {
        "jsCode": "const job = $('Postgres Trigger').first().json.payload;\nconst jobId = job.id;\n\n// Chemins Docker\nconst inputBasePath = '/clothify_shared/input_image/';\nconst outputBasePath = '/clothify_shared/output_image/';\n\n// Gestion robuste des inputs\nlet inputFilePaths = job.input_file_paths || [];\nif (typeof inputFilePaths === 'string') {\n  inputFilePaths = JSON.parse(inputFilePaths);\n}\n\n// Normalisation des entrées\nconst garmentType = String(job.garment || 'other').toLowerCase();\nconst sizeCode = String(job.size || '2');\nconst productName = job.product_name || 'product';\nconst customPrompt = job.custom_prompt || null;\n\nif (!inputFilePaths || inputFilePaths.length === 0) {\n  throw new Error('No input files found for job: ' + jobId);\n}\n\n// Logique de taille\nfunction getSizeInfo(code) {\n  switch(code) {\n    case '1': return { code: 'XS', label: 'Extra Small', bodyDescription: 'petite slim build, 155-160cm', fit: 'fitted' };\n    case '3': return { code: 'L', label: 'Large', bodyDescription: 'athletic build, 175-180cm', fit: 'comfortable fit' };\n    case '4': return { code: 'XL', label: 'Extra Large', bodyDescription: 'plus size, 170-175cm', fit: 'relaxed fit' };\n    default: return { code: 'S/M', label: 'Small/Medium', bodyDescription: 'average build, 165-170cm', fit: 'regular fit' };\n  }\n}\n\n// Logique de type (Vêtement vs Objet Custom)\nfunction getTypeInfo(type) {\n  switch(type) {\n    case 'echarpe': return { category: 'accessory', placement: 'draped around neck', focus: 'texture and pattern' };\n    case 'pull': return { category: 'top', placement: 'worn on upper body', focus: 'knit texture' };\n    case 'tshirt': return { category: 'top', placement: 'casual upper body', focus: 'fabric drape' };\n    case 'chemise': return { category: 'top', placement: 'buttoned, collar visible', focus: 'collar, buttons' };\n    case 'veste': return { category: 'outerwear', placement: 'worn open', focus: 'structure, lapels' };\n    case 'manteau': return { category: 'outerwear', placement: 'full length', focus: 'silhouette' };\n    case 'pantalon': return { category: 'bottom', placement: 'full length lower body', focus: 'waist fit, leg line' };\n    case 'jean': return { category: 'bottom', placement: 'casual stance', focus: 'denim texture' };\n    case 'short': return { category: 'bottom', placement: 'thigh length', focus: 'fit and proportion' };\n    case 'jupe': return { category: 'bottom', placement: 'movement captured', focus: 'flow, silhouette' };\n    case 'robe': return { category: 'dress', placement: 'full body elegant', focus: 'silhouette, fabric' };\n    case 'bonnet': return { category: 'accessory', placement: 'on head', focus: 'fit and texture' };\n    case 'casquette': return { category: 'accessory', placement: 'on head front', focus: 'shape' };\n    case 'sac': return { category: 'accessory', placement: 'held or shoulder', focus: 'shape, material' };\n    \n    // Cas par défaut pour objets inconnus (banane, téléphone, etc.)\n    default: return { \n      category: 'custom', \n      placement: 'integrated naturally into the scene matching its function', \n      focus: 'realistic texture, lighting match and high fidelity details' \n    };\n  }\n}\n\nconst sizeInfo = getSizeInfo(sizeCode);\nconst typeInfo = getTypeInfo(garmentType);\n\n// Construction des chemins de sortie\nconst primaryInputPath = inputFilePaths[0];\nconst fileName = primaryInputPath.split('/').pop();\nconst dotIndex = fileName.lastIndexOf('.');\nconst nameWithoutExt = fileName.substring(0, dotIndex);\nconst outputPath = outputBasePath + nameWithoutExt + '_generated.png';\n\n// Génération du tableau de résultats\nconst results = [];\nfor (let i = 0; i < inputFilePaths.length; i++) {\n  const relativePath = inputFilePaths[i];\n  const fName = relativePath.split('/').pop();\n  const absolutePath = inputBasePath + fName;\n  const extIndex = fName.lastIndexOf('.');\n  const ext = fName.substring(extIndex + 1).toLowerCase();\n  \n  let mime = 'image/jpeg';\n  if (ext === 'png') mime = 'image/png';\n  else if (ext === 'webp') mime = 'image/webp';\n  \n  results.push({\n    json: {\n      jobId,\n      inputFilePaths,\n      imagePath: absolutePath,\n      imageIndex: i,\n      totalImages: inputFilePaths.length,\n      mimeType: mime,\n      outputPath,\n      productName,\n      garmentType,\n      sizeCode,\n      sizeInfo,\n      typeInfo,\n      customPrompt,\n      discordMessageId: job.discord_message_id,\n      userId: job.user_id\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "c023a89a-6062-4493-8e06-c3033e814bed",
      "name": "🏷️ Parse Job Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
