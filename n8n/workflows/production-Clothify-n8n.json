    {
      "parameters": {
        "jsCode": "// Récupérer les données depuis Generate Prompt (qui contient le prompt)\nconst promptData = $('✨ Generate Prompt').first().json;\n\n// Récupérer TOUTES les images lues\nconst allItems = $input.all();\n\n// Format OpenAI/OpenRouter : un tableau de parts typées\nconst content = [\n  { type: 'text', text: promptData.prompt }\n];\n\n// Chaque image est envoyée en data URI base64\nfor (const item of allItems) {\n  const binaryData = item.binary?.data?.data;\n  if (binaryData) {\n    const mimeType = item.json.mimeType || 'image/png';\n    content.push({\n      type: 'image_url',\n      image_url: {\n        url: `data:${mimeType};base64,${binaryData}`,\n        detail: 'high'\n      }\n    });\n  }\n}\n\nif (content.length === 1) {\n  return [{\n    json: {\n      error: 'No images found!',\n      totalItems: allItems.length\n    }\n  }];\n}\n\n// Build OpenRouter API body\n// max_tokens est indispensable : OpenRouter reserve du credit sur le PIRE cas,\n// pas sur la consommation reelle. Sans plafond, la requete reclame le maximum\n// du modele (65536 tokens) et est refusee en 402 des que le solde est modeste,\n// alors que l'image ne coutera que quelques centimes. Une image pese ~7000\n// tokens de sortie : 16384 laisse une marge large.\nconst apiBody = {\n  model: 'openai/gpt-5.4-image-2',\n  modalities: ['image', 'text'],\n  max_tokens: 16384,\n  messages: [\n    {\n      role: 'user',\n      content: content\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...promptData,\n    apiBody,\n    imagesCount: content.length - 1\n  }\n}];"
      },
      "id": "8e4a92ce-d4be-4097-8318-ecf6cb666062",
      "name": "📦 Prepare API Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        -272
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst promptData = $('✨ Generate Prompt').item.json;\n\nlet imageBase64 = null;\nlet textResponse = '';\n\n// Erreur renvoyée par OpenRouter (200 avec corps d'erreur, ou relais fournisseur)\nif (response.error) {\n  const msg = response.error.message || JSON.stringify(response.error);\n  throw new Error('OpenRouter error: ' + msg);\n}\n\nconst choice = (response.choices || [])[0];\nconst message = choice ? choice.message : null;\n\nif (message) {\n  if (typeof message.content === 'string') {\n    textResponse = message.content;\n  }\n  if (message.refusal) {\n    throw new Error('Model refused the request: ' + message.refusal);\n  }\n  // L'image est dans choices[0].message.images[].image_url.url\n  for (const img of (message.images || [])) {\n    const url = img?.image_url?.url;\n    if (!url) continue;\n    if (url.startsWith('data:')) {\n      // data URI complet : on ne garde que la charge base64\n      imageBase64 = url.slice(url.indexOf(',') + 1);\n    } else {\n      throw new Error('Image returned as remote URL, not base64: ' + url.slice(0, 120));\n    }\n  }\n}\n\nif (!imageBase64) {\n  const reason = choice ? (choice.finish_reason || 'unknown') : 'no choice';\n  throw new Error(\n    'No image in API response (finish_reason=' + reason + '): ' +\n    JSON.stringify(response).substring(0, 500)\n  );\n}\n\nreturn [{\n  json: {\n    jobId: promptData.jobId,\n    outputPath: promptData.outputPath,\n    fileName: promptData.fileName,\n    nameWithoutExt: promptData.nameWithoutExt,\n    textResponse,\n    success: true\n  },\n  binary: {\n    data: {\n      data: imageBase64,\n      mimeType: 'image/png',\n      fileName: promptData.nameWithoutExt + '_generated.png'\n    }\n  }\n}];"
      },
      "id": "eb1ff047-e92d-42f4-8671-3a3e835d5cd5",
      "name": "🖼️ Extract Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
