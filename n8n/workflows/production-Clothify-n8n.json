      "parameters": {
        "jsCode": "const extractData = $('🖼️ Extract Image').item.json;\nconst promptData = $('✨ Generate Prompt').item.json;\n\nreturn [{\n  json: {\n    status: '✅ SUCCESS',\n    jobId: extractData.jobId,\n    input: promptData.fileName,\n    output: extractData.outputPath,\n    product: promptData.productName,\n    type: promptData.garmentType,\n    size: promptData.sizeInfo.label,\n    completedAt: new Date().toISOString()\n  }\n}];"
