      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst { productName, garmentType, sizeInfo, typeInfo, customPrompt } = data;\n\nlet prompt;\n\n// LOGIQUE CHIRURGICALE :\n// Si l'objet est 'custom' (inconnu), on remplace \"GARMENT\" par \"ITEM\" dans le prompt.\nconst itemLabel = (typeInfo.category === 'custom') ? 'ITEM' : 'GARMENT';\n\nif (customPrompt && customPrompt.trim() !== '') {\n  // Cas 1 : Prompt utilisateur manuel (Priorité absolue)\n  prompt = `${customPrompt}\\n\\nAdditional context:\\n- Product: ${productName.replace(/_/g, ' ')}\\n- Type: ${garmentType}\\n- Model size: ${sizeInfo.label} (${sizeInfo.bodyDescription})\\n\\nKeep original design and colors. Professional e-commerce style.`;\n} else {\n  // Cas 2 : Génération automatique (Standard ou Objet Custom)\n  prompt = `Transform this product photo into a professional image.\n\nTASK: Place this ${garmentType} (${productName.replace(/_/g, ' ')}) on a realistic ${$('Postgres Trigger').first().json.payload.genre} model.\n\nMODEL: ${sizeInfo.bodyDescription}, ${sizeInfo.label}.\\n\\n${itemLabel}: ${typeInfo.placement}. Focus on ${typeInfo.focus}. Keep original design and colors.\n\nSTYLE: Professional studio lighting, a realistic gray light  wall in background, high-resolution, luxury e-commerce (NET-A-PORTER style).\n\nPOSE CONSTRAINTS:\nBody orientation: three-quarter back (~130° yaw).\nCamera framing: neck-down shot, frame starts below the jawline.\nHead completely out of frame. No face, no head visible.\n`}\n\nreturn [{ json: { ...data, prompt } }];"
      },
