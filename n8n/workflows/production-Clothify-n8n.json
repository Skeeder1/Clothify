    {
      "parameters": {
        "jsCode": "// Get the error and job ID from context\nconst errorMessage = $input.first().json?.error?.message || $execution?.error?.message || 'Unknown error during processing';\n\n// Try to get jobId from various possible sources\nlet jobId = null;\ntry {\n  jobId = $('🏷️ Parse Job Data2').item?.json?.jobId;\n} catch (e) {\n  try {\n    jobId = $('📝 Update Processing').item?.json?.id;\n  } catch (e2) {\n    try {\n      jobId = $('🔍 Filter Pending').item?.json?.id;\n    } catch (e3) {\n      // No job ID found\n    }\n  }\n}\n\nif (!jobId) {\n  throw new Error('Cannot update error status: no job ID found. Original error: ' + errorMessage);\n}\n\nreturn [{\n  json: {\n    jobId,\n    errorMessage: errorMessage.substring(0, 1000)\n  }\n}];"
      },
